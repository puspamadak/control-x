{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "companion": {
      "root": "apps/companion",
      "framework": "vite"
    },
    "quest": {
      "root": "apps/quest",
      "framework": "vite"
    },
    "server": {
      "root": "apps/server",
      "framework": "express"
    },
    "sim": {
      "root": "apps/sim",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "server"
      }
    }
  ]
}
